// Fenêtre principale de l'explorateur.
// La logique (sélection, raccourcis, commandes) est en Rust : cette interface transmet les
// événements bruts et affiche l'état.

import { ListView, LineEdit, ScrollView, Palette } from "std-widgets.slint";

export struct Row {
    name: string,
    modified: string,
    kind: string,
    size: string,
    is-dir: bool,
    dimmed: bool,
    // État cloud : 0 aucun, 1 en ligne seulement, 2 disponible localement, 3 toujours conservé.
    cloud: int,
    selected: bool,
    focused: bool,
    has-icon: bool,
    icon: image,
}

// Ligne de la vue icônes : `items` sont les éléments `first`, `first + 1`…
export struct GridLine {
    first: int,
    items: [Row],
}

export struct NavItem {
    label: string,
    glyph: string,
    path: string,
    header: bool,
    current: bool,
}

export struct Crumb {
    label: string,
    path: string,
}

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <brush> layer: dark ? #3a3a3a4c : #ffffff80;
    out property <brush> hover: dark ? #ffffff0f : #0000000a;
    out property <brush> pressed: dark ? #ffffff0a : #00000006;
    out property <brush> selected: dark ? #ffffff15 : #0000000f;
    out property <brush> selected-hover: dark ? #ffffff1f : #00000017;
    out property <brush> divider: dark ? #ffffff15 : #0000000f;
    out property <brush> text-secondary: dark ? #ffffffc5 : #000000a0;
    out property <brush> text-disabled: dark ? #ffffff5d : #0000005c;
    out property <brush> field: dark ? #ffffff0f : #ffffffb3;
    out property <brush> popup: dark ? #2c2c2c : #f9f9f9;
    out property <brush> folder: #e8b84a;
    out property <length> row-height: 32px;
    // Vue icônes : tuile et icône (96 px, comme les « grandes icônes » de l'Explorateur).
    out property <length> tile-width: 112px;
    out property <length> tile-height: 140px;
    out property <length> tile-icon: 96px;
    out property <string> icons: "Segoe Fluent Icons";
}

component ToolButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> enabled: true;
    in property <string> tooltip;
    callback clicked;
    width: 36px;
    height: 32px;
    border-radius: 4px;
    background: !enabled ? transparent : ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: tooltip;
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.glyph;
        font-family: Theme.icons;
        font-size: 16px;
        color: root.enabled ? Palette.foreground : Theme.text-disabled;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <bool> sorted;
    in property <bool> descending;
    in property <bool> align-right;
    in-out property <length> col-width;
    callback clicked;
    width: col-width;
    accessible-role: button;
    accessible-label: text;
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    Rectangle {
        background: ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : transparent;
    }
    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.text;
        font-size: 12px;
        color: Theme.text-secondary;
        vertical-alignment: center;
        horizontal-alignment: root.align-right ? right : left;
        overflow: elide;
    }
    if root.sorted: Text {
        y: -1px;
        width: parent.width;
        height: 10px;
        text: root.descending ? "\u{E70D}" : "\u{E70E}";
        font-family: Theme.icons;
        font-size: 8px;
        color: Theme.text-secondary;
        horizontal-alignment: center;
    }
    Rectangle {
        x: parent.width - 4px;
        width: 8px;
        Rectangle {
            x: 3px;
            width: 1px;
            height: 50%;
            background: Theme.divider;
        }
        TouchArea {
            mouse-cursor: col-resize;
            moved => {
                if self.pressed {
                    root.col-width = max(48px, root.col-width + self.mouse-x - self.pressed-x);
                }
            }
        }
    }
}

component FileRow inherits Rectangle {
    in property <Row> data;
    in property <int> index;
    in property <bool> list-has-focus;
    in property <bool> drop-target;
    in property <bool> renaming;
    in property <string> rename-text;
    in property <int> rename-stem;
    in property <length> w-name;
    in property <length> w-state;
    in property <length> w-date;
    in property <length> w-type;
    in property <length> w-size;
    // kind : 0 appui gauche, 1 relâchement gauche, 2 double-clic, 3 relâchement droit
    callback pointer(kind: int, ctrl: bool, shift: bool, on-name: bool);
    callback drag-moved(content-x: length, content-y: length, on-name: bool);
    callback rename-commit(text: string);
    callback rename-cancel();
    height: Theme.row-height;
    accessible-role: list-item;
    accessible-label: data.name;
    accessible-item-selected: data.selected;

    property <bool> pressed-on-name;

    ta := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.pressed-on-name = self.mouse-x < root.w-name;
                root.pointer(0, e.modifiers.control, e.modifiers.shift, root.pressed-on-name);
            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                root.pointer(1, e.modifiers.control, e.modifiers.shift, root.pressed-on-name);
            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                root.pointer(3, e.modifiers.control, e.modifiers.shift, true);
            }
        }
        double-clicked => { root.pointer(2, false, false, true); }
        moved => {
            if self.pressed {
                root.drag-moved(self.mouse-x, root.index * Theme.row-height + self.mouse-y, root.pressed-on-name);
            }
        }
    }
    Rectangle {
        x: 4px;
        width: parent.width - 8px;
        y: 1px;
        height: parent.height - 2px;
        border-radius: 4px;
        background: root.drop-target ? Palette.accent-background.transparentize(0.6)
            : root.data.selected ? (ta.has-hover ? Theme.selected-hover : Theme.selected)
            : ta.has-hover ? Theme.hover : transparent;
        border-width: root.data.focused && root.list-has-focus ? 1px : 0px;
        border-color: Theme.text-disabled;
    }
    if root.data.selected: Rectangle {
        x: 4px;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: Palette.accent-background;
    }
    Rectangle {
        opacity: root.data.dimmed ? 0.55 : 1.0;
        if root.data.has-icon: Image {
            x: 14px;
            width: 16px;
            height: 16px;
            source: root.data.icon;
            image-fit: contain;
        }
        if !root.data.has-icon: Text {
            x: 14px;
            width: 20px;
            text: root.data.is-dir ? "\u{E8B7}" : "\u{E8A5}";
            font-family: Theme.icons;
            font-size: 16px;
            color: root.data.is-dir ? Theme.folder : Theme.text-secondary;
            vertical-alignment: center;
        }
        if !root.renaming: Text {
            x: 40px;
            width: root.w-name - 44px;
            text: root.data.name;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if root.renaming: edit := LineEdit {
        x: 36px;
        y: 2px;
        width: root.w-name - 36px;
        height: parent.height - 4px;
        font-size: 12px;
        text: root.rename-text;
        property <bool> done;
        init => {
            self.focus();
            self.set-selection-offsets(0, root.rename-stem);
        }
        accepted(t) => {
            self.done = true;
            root.rename-commit(t);
        }
        key-pressed(e) => {
            if e.text == Key.Escape {
                self.done = true;
                root.rename-cancel();
                return accept;
            }
            reject
        }
        changed has-focus => {
            if !self.has-focus && !self.done {
                self.done = true;
                root.rename-commit(self.text);
            }
        }
    }
    // Colonne État (OneDrive) : nuage = en ligne seulement, coche = disponible localement,
    // coche pleine = toujours conservé.
    if root.data.cloud > 0: Text {
        x: root.w-name + 12px;
        width: root.w-state - 12px;
        text: root.data.cloud == 1 ? "\u{E753}" : root.data.cloud == 2 ? "\u{E930}" : "\u{EC61}";
        font-family: Theme.icons;
        font-size: 14px;
        color: root.data.cloud == 1 ? #4cc2ff : #6ccb5f;
        vertical-alignment: center;
        accessible-role: text;
        accessible-label: root.data.cloud == 1 ? "Disponible en ligne seulement"
            : root.data.cloud == 2 ? "Disponible sur cet appareil" : "Toujours disponible sur cet appareil";
    }
    Text {
        x: root.w-name + root.w-state + 12px;
        width: root.w-date - 16px;
        text: root.data.modified;
        font-size: 12px;
        color: Theme.text-secondary;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: root.w-name + root.w-state + root.w-date + 12px;
        width: root.w-type - 16px;
        text: root.data.kind;
        font-size: 12px;
        color: Theme.text-secondary;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: root.w-name + root.w-state + root.w-date + root.w-type;
        width: root.w-size - 12px;
        text: root.data.size;
        font-size: 12px;
        color: Theme.text-secondary;
        vertical-alignment: center;
        horizontal-alignment: right;
        overflow: elide;
    }
}

// Tuile de la vue icônes : vignette ou icône, nom sur deux lignes.
component Tile inherits Rectangle {
    in property <Row> data;
    in property <bool> list-has-focus;
    in property <bool> drop-target;
    in property <bool> renaming;
    in property <string> rename-text;
    in property <int> rename-stem;
    // kind : 0 appui gauche, 1 relâchement gauche, 2 double-clic, 3 relâchement droit
    callback pointer(kind: int, ctrl: bool, shift: bool);
    callback drag-moved(dx: length, dy: length);
    callback rename-commit(text: string);
    callback rename-cancel();
    width: Theme.tile-width;
    height: Theme.tile-height;
    accessible-role: list-item;
    accessible-label: data.name;
    accessible-item-selected: data.selected;

    ta := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.pointer(0, e.modifiers.control, e.modifiers.shift);
            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                root.pointer(1, e.modifiers.control, e.modifiers.shift);
            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                root.pointer(3, e.modifiers.control, e.modifiers.shift);
            }
        }
        double-clicked => { root.pointer(2, false, false); }
        moved => {
            if self.pressed {
                root.drag-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }
    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        border-radius: 4px;
        background: root.drop-target ? Palette.accent-background.transparentize(0.6)
            : root.data.selected ? (ta.has-hover ? Theme.selected-hover : Theme.selected)
            : ta.has-hover ? Theme.hover : transparent;
        border-width: root.data.focused && root.list-has-focus ? 1px : 0px;
        border-color: Theme.text-disabled;
    }
    Rectangle {
        opacity: root.data.dimmed ? 0.55 : 1.0;
        Image {
            visible: root.data.has-icon;
            x: (parent.width - Theme.tile-icon) / 2;
            y: 8px;
            width: Theme.tile-icon;
            height: Theme.tile-icon;
            source: root.data.icon;
            image-fit: contain;
        }
        Text {
            visible: !root.data.has-icon;
            y: 8px;
            width: parent.width;
            height: Theme.tile-icon;
            text: root.data.is-dir ? "\u{E8B7}" : "\u{E8A5}";
            font-family: Theme.icons;
            font-size: 56px;
            color: root.data.is-dir ? Theme.folder : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            visible: !root.renaming;
            x: 6px;
            y: Theme.tile-icon + 12px;
            width: parent.width - 12px;
            height: parent.height - Theme.tile-icon - 16px;
            text: root.data.name;
            font-size: 12px;
            wrap: word-wrap;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: top;
        }
    }
    Text {
        visible: root.data.cloud > 0;
        x: 10px;
        y: Theme.tile-icon - 8px;
        text: root.data.cloud == 1 ? "\u{E753}" : root.data.cloud == 2 ? "\u{E930}" : "\u{EC61}";
        font-family: Theme.icons;
        font-size: 14px;
        color: root.data.cloud == 1 ? #4cc2ff : #6ccb5f;
        accessible-role: text;
        accessible-label: root.data.cloud == 1 ? "Disponible en ligne seulement"
            : root.data.cloud == 2 ? "Disponible sur cet appareil" : "Toujours disponible sur cet appareil";
    }
    if root.renaming: LineEdit {
        x: 2px;
        y: Theme.tile-icon + 8px;
        width: parent.width - 4px;
        height: 28px;
        font-size: 12px;
        text: root.rename-text;
        property <bool> done;
        init => {
            self.focus();
            self.set-selection-offsets(0, root.rename-stem);
        }
        accepted(t) => {
            self.done = true;
            root.rename-commit(t);
        }
        key-pressed(e) => {
            if e.text == Key.Escape {
                self.done = true;
                root.rename-cancel();
                return accept;
            }
            reject
        }
        changed has-focus => {
            if !self.has-focus && !self.done {
                self.done = true;
                root.rename-commit(self.text);
            }
        }
    }
}

component NavPane inherits Rectangle {
    in property <[NavItem]> items;
    callback activated(path: string);
    width: 220px;
    ScrollView {
        VerticalLayout {
            padding: 8px;
            spacing: 2px;
            alignment: start;
            for item in root.items: Rectangle {
                height: item.header ? 28px : 32px;
                border-radius: 4px;
                background: item.header ? transparent : item.current ? Theme.selected : nta.has-hover ? Theme.hover : transparent;
                accessible-role: button;
                accessible-label: item.label;
                nta := TouchArea {
                    enabled: !item.header;
                    clicked => { root.activated(item.path); }
                }
                if item.current: Rectangle {
                    x: 0px;
                    width: 3px;
                    height: 16px;
                    border-radius: 1.5px;
                    background: Palette.accent-background;
                }
                if !item.header: Text {
                    x: 12px;
                    text: item.glyph;
                    font-family: Theme.icons;
                    font-size: 16px;
                    color: item.glyph == "\u{E8B7}" ? Theme.folder : Palette.foreground;
                    vertical-alignment: center;
                }
                Text {
                    x: item.header ? 8px : 40px;
                    width: parent.width - self.x - 8px;
                    text: item.label;
                    font-size: 12px;
                    font-weight: item.header ? 600 : 400;
                    color: item.header ? Theme.text-secondary : Palette.foreground;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

export struct TabItem {
    title: string,
    active: bool,
}

export struct PaletteItem {
    label: string,
    hint: string,
}

// Volet de dossier : en-tête, liste virtualisée, rectangle de sélection, barre d'état.
// Instancié deux fois (double volet) ; tous les événements remontent avec l'index du volet.
component FolderPane inherits Rectangle {
    in property <[Row]> rows;
    in property <bool> active;
    in property <bool> show-active;
    in property <string> status;
    in property <string> error-text;
    in property <bool> loading;
    in property <bool> filtering;
    in property <int> sort-column;
    in property <bool> sort-descending;
    in property <int> rename-row: -1;
    in property <string> rename-text;
    in property <int> rename-stem;
    in property <int> drop-row: -1;
    // 0 détails, 1 icônes
    in property <int> view-mode;
    in property <[GridLine]> grid-lines;
    property <bool> grid: root.view-mode == 1;
    property <length> line-height: grid ? Theme.tile-height : Theme.row-height;
    property <length> content-y: grid ? grid-list.content-y : file-list.content-y;
    out property <length> visible-height: grid ? grid-list.visible-height : file-list.visible-height;
    out property <int> grid-columns: max(1, floor((list-area.width - 8px) / Theme.tile-width));
    // Lignes par page (en vue icônes : lignes de tuiles).
    out property <int> page-rows: max(1, floor(root.visible-height / root.line-height) - 1);
    out property <length> max-scroll: max(0px, (grid ? grid-list.content-height : file-list.content-height) - root.visible-height);
    out property <length> scroll-y: -root.content-y;

    callback activated();
    callback sort-by(int);
    callback row-pointer(row: int, kind: int, ctrl: bool, shift: bool, on-name: bool);
    callback background-pointer(kind: int, ctrl: bool, shift: bool);
    callback drag-out(row: int);
    callback marquee-changed(row-a: int, row-b: int, ctrl: bool);
    callback marquee-ended();
    callback marquee-grid(line-a: int, line-b: int, col-a: int, col-b: int);
    callback columns-changed(int);
    callback rename-commit(string);
    callback rename-cancel();
    callback key(text: string, ctrl: bool, shift: bool, alt: bool) -> bool;

    in-out property <length> w-name: 340px;
    in-out property <length> w-state: 56px;
    in-out property <length> w-date: 160px;
    in-out property <length> w-type: 170px;
    in-out property <length> w-size: 100px;

    property <bool> marquee-active;
    property <length> mq-x0;
    property <length> mq-y0;
    property <length> mq-x1;
    property <length> mq-y1;
    property <bool> drag-started;

    background: Theme.layer;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    // Largeur préférée faible : en double volet, l'espace est partagé à égalité (sinon la somme
    // des colonnes imposerait sa largeur au premier volet). Le contenu qui dépasse est découpé.
    preferred-width: 200px;
    min-width: 160px;
    clip: true;

    changed grid-columns => {
        root.columns-changed(self.grid-columns);
    }

    public function scroll-to-row(row: int) {
        if row < 0 {
            return;
        }
        let line = root.grid ? floor(row / root.grid-columns) : row;
        let top = -root.content-y;
        let target = line * root.line-height < top ? line * root.line-height
            : (line + 1) * root.line-height > top + root.visible-height ? (line + 1) * root.line-height - root.visible-height
            : top;
        root.set-scroll(target);
    }
    public function set-scroll(y: length) {
        if root.grid {
            grid-list.content-y = -y;
        } else {
            file-list.content-y = -y;
        }
    }
    public function focus-list() {
        list-focus.focus();
    }
    public function contains(x: length, y: length) -> bool {
        x >= list-area.absolute-position.x && x <= list-area.absolute-position.x + list-area.width
            && y >= list-area.absolute-position.y && y <= list-area.absolute-position.y + list-area.height
    }
    // Ligne sous un point de la fenêtre (pixels logiques), -1 si hors des lignes.
    public function row-at(x: length, y: length) -> int {
        if !root.contains(x, y) {
            return -1;
        }
        let line = floor((y - list-area.absolute-position.y - root.content-y) / root.line-height);
        if !root.grid {
            return line < root.rows.length ? line : -1;
        }
        let col = floor((x - list-area.absolute-position.x - 4px) / Theme.tile-width);
        if col < 0 || col >= root.grid-columns {
            return -1;
        }
        let r = line * root.grid-columns + col;
        return r < root.rows.length ? r : -1;
    }
    public function row-anchor-x() -> length {
        list-area.absolute-position.x + 48px
    }
    public function row-anchor-y(row: int) -> length {
        let line = root.grid ? floor(row / root.grid-columns) : row;
        list-area.absolute-position.y + root.content-y + (line + 1) * root.line-height
    }

    function marquee-update(cx: length, cy: length) {
        root.mq-x1 = cx;
        root.mq-y1 = cy;
        if !root.marquee-active && (abs(root.mq-x1 - root.mq-x0) > 4px || abs(root.mq-y1 - root.mq-y0) > 4px) {
            root.marquee-active = true;
        }
        if root.marquee-active && root.grid {
            root.marquee-grid(
                floor(max(0px, min(root.mq-y0, root.mq-y1)) / Theme.tile-height),
                floor(max(root.mq-y0, root.mq-y1) / Theme.tile-height),
                max(0, floor((min(root.mq-x0, root.mq-x1) - 4px) / Theme.tile-width)),
                min(root.grid-columns - 1, floor((max(root.mq-x0, root.mq-x1) - 4px) / Theme.tile-width)));
        } else if root.marquee-active {
            root.marquee-changed(
                floor(min(root.mq-y0, root.mq-y1) / Theme.row-height),
                floor(max(root.mq-y0, root.mq-y1) / Theme.row-height),
                false);
        }
    }

    // Volet actif en double volet : liseré d'accent.
    if root.show-active: Rectangle {
        y: 0px;
        height: 2px;
        x: 8px;
        width: parent.width - 16px;
        background: Palette.accent-background;
        border-radius: 1px;
    }

    VerticalLayout {
        padding-top: 4px;
        if !root.grid: Rectangle {
            height: 32px;
            HorizontalLayout {
                padding-left: 4px;
                alignment: start;
                HeaderCell {
                    text: "Nom";
                    col-width <=> root.w-name;
                    sorted: root.sort-column == 0;
                    descending: root.sort-descending;
                    clicked => { root.activated(); root.sort-by(0); }
                }
                HeaderCell {
                    text: "État";
                    col-width <=> root.w-state;
                }
                HeaderCell {
                    text: "Modifié le";
                    col-width <=> root.w-date;
                    sorted: root.sort-column == 1;
                    descending: root.sort-descending;
                    clicked => { root.activated(); root.sort-by(1); }
                }
                HeaderCell {
                    text: "Type";
                    col-width <=> root.w-type;
                    sorted: root.sort-column == 2;
                    descending: root.sort-descending;
                    clicked => { root.activated(); root.sort-by(2); }
                }
                HeaderCell {
                    text: "Taille";
                    align-right: true;
                    col-width <=> root.w-size;
                    sorted: root.sort-column == 3;
                    descending: root.sort-descending;
                    clicked => { root.activated(); root.sort-by(3); }
                }
            }
        }
        list-area := Rectangle {
            list-focus := FocusScope {
                accessible-role: list;
                accessible-label: "Contenu du dossier";
                key-pressed(event) => {
                    if root.key(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt) {
                        return accept;
                    }
                    reject
                }
                changed has-focus => {
                    if self.has-focus {
                        root.activated();
                    }
                }
                // Zone vide sous les lignes : désélection, menu de fond, rectangle.
                TouchArea {
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                            list-focus.focus();
                            root.activated();
                            root.mq-x0 = self.mouse-x;
                            root.mq-y0 = self.mouse-y - root.content-y;
                            root.marquee-active = false;
                            root.background-pointer(0, e.modifiers.control, e.modifiers.shift);
                        } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                            if root.marquee-active {
                                root.marquee-active = false;
                                root.marquee-ended();
                            }
                        } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                            root.activated();
                            root.background-pointer(3, e.modifiers.control, e.modifiers.shift);
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.marquee-update(self.mouse-x, self.mouse-y - root.content-y);
                        }
                    }
                }
                file-list := ListView {
                    visible: !root.grid;
                    for row[i] in (root.grid ? [] : root.rows): FileRow {
                        data: row;
                        index: i;
                        list-has-focus: list-focus.has-focus;
                        drop-target: i == root.drop-row;
                        renaming: i == root.rename-row;
                        rename-text: root.rename-text;
                        rename-stem: root.rename-stem;
                        w-name: root.w-name;
                        w-state: root.w-state;
                        w-date: root.w-date;
                        w-type: root.w-type;
                        w-size: root.w-size;
                        pointer(kind, ctrl, shift, on-name) => {
                            if kind == 0 {
                                list-focus.focus();
                                root.activated();
                                root.drag-started = false;
                                root.mq-x0 = 0px;
                                root.mq-y0 = i * Theme.row-height;
                                root.marquee-active = false;
                            }
                            if kind == 3 {
                                root.activated();
                            }
                            if kind == 1 && root.marquee-active {
                                root.marquee-active = false;
                                root.marquee-ended();
                                return;
                            }
                            root.row-pointer(i, kind, ctrl, shift, on-name);
                        }
                        drag-moved(cx, cy, on-name) => {
                            if on-name {
                                if !root.drag-started && abs(cy - root.mq-y0) > 6px {
                                    root.drag-started = true;
                                    root.drag-out(i);
                                }
                            } else {
                                root.marquee-update(cx, cy);
                            }
                        }
                        rename-commit(t) => { root.rename-commit(t); }
                        rename-cancel => { root.rename-cancel(); }
                    }
                }
                grid-list := ListView {
                    visible: root.grid;
                    for line in root.grid-lines: Rectangle {
                        height: Theme.tile-height;
                        for item[k] in line.items: Tile {
                            x: 4px + k * Theme.tile-width;
                            y: 0px;
                            data: item;
                            list-has-focus: list-focus.has-focus;
                            drop-target: line.first + k == root.drop-row;
                            renaming: line.first + k == root.rename-row;
                            rename-text: root.rename-text;
                            rename-stem: root.rename-stem;
                            pointer(kind, ctrl, shift) => {
                                if kind == 0 {
                                    list-focus.focus();
                                    root.activated();
                                    root.drag-started = false;
                                    root.marquee-active = false;
                                }
                                if kind == 3 {
                                    root.activated();
                                }
                                root.row-pointer(line.first + k, kind, ctrl, shift, true);
                            }
                            drag-moved(dx, dy) => {
                                if !root.drag-started && (abs(dx) > 6px || abs(dy) > 6px) {
                                    root.drag-started = true;
                                    root.drag-out(line.first + k);
                                }
                            }
                            rename-commit(t) => { root.rename-commit(t); }
                            rename-cancel => { root.rename-cancel(); }
                        }
                    }
                }
                if root.marquee-active: Rectangle {
                    x: min(root.mq-x0, root.mq-x1);
                    y: min(root.mq-y0, root.mq-y1) + root.content-y;
                    width: abs(root.mq-x1 - root.mq-x0);
                    height: abs(root.mq-y1 - root.mq-y0);
                    background: Palette.accent-background.transparentize(0.75);
                    border-width: 1px;
                    border-color: Palette.accent-background;
                }
                if root.error-text != "": Rectangle {
                    Text {
                        x: 24px;
                        y: 24px;
                        width: parent.width - 48px;
                        text: root.error-text;
                        wrap: word-wrap;
                        font-size: 14px;
                        color: Theme.text-secondary;
                    }
                }
                if root.error-text == "" && !root.loading && root.rows.length == 0: Text {
                    y: 24px;
                    text: root.filtering ? "Aucun élément ne correspond au filtre." : "Ce dossier est vide.";
                    font-size: 12px;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }
            }
        }
        Rectangle {
            height: 26px;
            Text {
                x: 16px;
                width: parent.width - 24px;
                text: root.loading ? "Chargement…  " + root.status : root.status;
                font-size: 12px;
                color: Theme.text-secondary;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

component TabStrip inherits Rectangle {
    in property <[TabItem]> tabs;
    clip: true;
    callback activated(int);
    callback closed(int);
    callback new-tab();
    height: 36px;
    HorizontalLayout {
        padding-left: 8px;
        padding-top: 4px;
        spacing: 2px;
        alignment: start;
        for item[i] in root.tabs: Rectangle {
            width: 200px;
            border-top-left-radius: 6px;
            border-top-right-radius: 6px;
            background: item.active ? Theme.layer : tta.has-hover ? Theme.hover : transparent;
            accessible-role: tab;
            accessible-label: item.title;
            tta := TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.up && e.button == PointerEventButton.middle {
                        root.closed(i);
                    } else if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        root.activated(i);
                    }
                }
            }
            Text {
                x: 12px;
                width: parent.width - 44px;
                text: item.title;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                x: parent.width - 30px;
                width: 24px;
                height: 24px;
                border-radius: 4px;
                background: cta.has-hover ? Theme.hover : transparent;
                cta := TouchArea {
                    clicked => { root.closed(i); }
                }
                Text {
                    text: "\u{E711}";
                    font-family: Theme.icons;
                    font-size: 10px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: Theme.text-secondary;
                }
            }
        }
        ToolButton {
            glyph: "\u{E710}";
            tooltip: "Nouvel onglet (Ctrl+T)";
            height: 28px;
            width: 32px;
            clicked => { root.new-tab(); }
        }
    }
}

export component MainWindow inherits Window {
    title: root.folder-title == "" ? "WinDir" : root.folder-title + " — WinDir";
    preferred-width: 1200px;
    preferred-height: 760px;
    min-width: 560px;
    min-height: 360px;
    default-font-family: "Segoe UI Variable Text";
    in property <bool> mica: true;
    background: mica ? transparent : Palette.background;

    // --- Fenêtre ---
    in property <[TabItem]> tabs;
    in property <bool> dual;
    in property <int> active-pane;
    in property <[NavItem]> nav-items;
    in property <[Crumb]> crumbs;
    in property <[string]> suggestions;
    in-out property <int> suggestion-index: -1;
    in property <string> folder-title;
    in-out property <string> address;
    in-out property <bool> address-editing;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> can-up;
    in-out property <string> filter-text;

    // --- Volets (suffixe = index du volet) ---
    in property <[Row]> rows-0;
    in property <[Row]> rows-1;
    in property <string> status-0;
    in property <string> status-1;
    in property <string> error-text-0;
    in property <string> error-text-1;
    in property <bool> loading-0;
    in property <bool> loading-1;
    in property <bool> filtering-0;
    in property <bool> filtering-1;
    in property <int> sort-column-0;
    in property <int> sort-column-1;
    in property <bool> sort-descending-0;
    in property <bool> sort-descending-1;
    in property <int> rename-row-0: -1;
    in property <int> rename-row-1: -1;
    in property <string> rename-text-0;
    in property <string> rename-text-1;
    in property <int> rename-stem-0;
    in property <int> rename-stem-1;
    in property <int> drop-row-0: -1;
    in property <int> drop-row-1: -1;
    in property <int> view-mode-0;
    in property <int> view-mode-1;
    in property <[GridLine]> grid-lines-0;
    in property <[GridLine]> grid-lines-1;
    out property <int> grid-columns-0: p0.grid-columns;
    out property <int> grid-columns-1: p1.grid-columns;
    out property <int> page-rows-0: p0.page-rows;
    out property <int> page-rows-1: p1.page-rows;
    out property <length> max-scroll-0: p0.max-scroll;
    out property <length> max-scroll-1: p1.max-scroll;
    out property <length> scroll-y-0: p0.scroll-y;
    out property <length> scroll-y-1: p1.scroll-y;
    out property <length> view-height-0: p0.visible-height;
    out property <length> view-height-1: p1.visible-height;

    // --- Volet d'aperçu ---
    in property <bool> preview-visible;
    // 0 message, 1 texte, 2 image, 3 aperçu natif (fenêtre enfant posée par Rust)
    in property <int> preview-kind;
    in property <string> preview-title;
    in property <string> preview-text;
    in property <image> preview-image;
    out property <length> preview-x: preview-area.absolute-position.x;
    out property <length> preview-y: preview-area.absolute-position.y;
    out property <length> preview-width: preview-area.width;
    out property <length> preview-height: preview-area.height;

    // --- Palette de commandes ---
    in-out property <bool> palette-open;
    in-out property <string> palette-query;
    in property <[PaletteItem]> palette-items;
    in-out property <int> palette-index;

    // --- Actions vers Rust ---
    callback navigate-to(string);
    callback address-edited(string);
    callback go-back();
    callback go-forward();
    callback go-up();
    callback refresh();
    callback nav-activated(string);
    callback crumb-activated(string);
    callback filter-edited(string);
    callback tab-activated(int);
    callback tab-closed(int);
    callback new-tab();
    callback toggle-dual();
    callback toggle-preview();
    callback pane-activated(pane: int);
    callback sort-by(pane: int, col: int);
    callback row-pointer(pane: int, row: int, kind: int, ctrl: bool, shift: bool, on-name: bool);
    callback background-pointer(pane: int, kind: int, ctrl: bool, shift: bool);
    callback drag-out(pane: int, row: int);
    callback marquee-changed(pane: int, row-a: int, row-b: int, ctrl: bool);
    callback marquee-ended(pane: int);
    callback marquee-grid(pane: int, line-a: int, line-b: int, col-a: int, col-b: int);
    callback columns-changed(pane: int, columns: int);
    callback toggle-view();
    callback rename-commit(pane: int, text: string);
    callback rename-cancel(pane: int);
    // pane = -1 : touche reçue hors des listes.
    callback key(pane: int, text: string, ctrl: bool, shift: bool, alt: bool) -> bool;
    callback palette-edited(string);
    callback palette-run(int);

    public function scroll-to-row(pane: int, row: int) {
        if pane == 1 { p1.scroll-to-row(row); } else { p0.scroll-to-row(row); }
    }
    public function set-scroll(pane: int, y: length) {
        if pane == 1 { p1.set-scroll(y); } else { p0.set-scroll(y); }
    }
    public function focus-list(pane: int) {
        if pane == 1 { p1.focus-list(); } else { p0.focus-list(); }
    }
    // Volet sous un point de la fenêtre (pixels logiques), -1 si aucun.
    public function pane-at(x: length, y: length) -> int {
        if p0.contains(x, y) {
            return 0;
        }
        if root.dual && p1.contains(x, y) {
            return 1;
        }
        return -1;
    }
    public function row-at(pane: int, x: length, y: length) -> int {
        if pane == 1 { return p1.row-at(x, y); }
        return p0.row-at(x, y);
    }
    public function row-anchor-x(pane: int) -> length {
        if pane == 1 { return p1.row-anchor-x(); }
        return p0.row-anchor-x();
    }
    public function row-anchor-y(pane: int, row: int) -> length {
        if pane == 1 { return p1.row-anchor-y(row); }
        return p0.row-anchor-y(row);
    }
    public function open-palette() {
        root.palette-open = true;
        root.palette-query = "";
        root.palette-index = 0;
        root.palette-edited("");
    }

    function start-address-edit() {
        root.address-editing = true;
        address-edit.focus();
        address-edit.select-all();
    }

    global-keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "l") || (event.modifiers.alt && event.text == "d") || event.text == Key.F4 {
                root.start-address-edit();
                return accept;
            }
            if event.modifiers.control && (event.text == "f" || event.text == "e") {
                filter-edit.focus();
                filter-edit.select-all();
                return accept;
            }
            if event.modifiers.control && event.modifiers.shift && (event.text == "p" || event.text == "P") {
                root.open-palette();
                return accept;
            }
            if root.key(-1, event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt) {
                return accept;
            }
            reject
        }

        VerticalLayout {
            TabStrip {
                tabs: root.tabs;
                activated(i) => { root.tab-activated(i); }
                closed(i) => { root.tab-closed(i); }
                new-tab => { root.new-tab(); }
            }
            // --- Barre de navigation ---
            HorizontalLayout {
                padding: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 4px;
                height: 44px;
                ToolButton {
                    glyph: "\u{E72B}";
                    tooltip: "Précédent (Alt+Gauche)";
                    enabled: root.can-back;
                    clicked => { root.go-back(); }
                }
                ToolButton {
                    glyph: "\u{E72A}";
                    tooltip: "Suivant (Alt+Droite)";
                    enabled: root.can-forward;
                    clicked => { root.go-forward(); }
                }
                ToolButton {
                    glyph: "\u{E74A}";
                    tooltip: "Dossier parent (Alt+Haut)";
                    enabled: root.can-up;
                    clicked => { root.go-up(); }
                }
                ToolButton {
                    glyph: "\u{E72C}";
                    tooltip: "Actualiser (F5, Ctrl+R en double volet)";
                    clicked => { root.refresh(); }
                }
                address-box := Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 4px;
                    clip: true;
                    background: Theme.field;
                    if !root.address-editing: TouchArea {
                        clicked => { root.start-address-edit(); }
                    }
                    if !root.address-editing: HorizontalLayout {
                        width: self.preferred-width;
                        x: min(0px, address-box.width - self.preferred-width - 6px);
                        padding-left: 6px;
                        alignment: start;
                        for crumb[i] in root.crumbs: HorizontalLayout {
                            if i > 0: Text {
                                text: "\u{E76C}";
                                font-family: Theme.icons;
                                font-size: 8px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                border-radius: 4px;
                                background: cta.has-hover ? Theme.hover : transparent;
                                accessible-role: button;
                                accessible-label: crumb.label;
                                cta := TouchArea {
                                    clicked => { root.crumb-activated(crumb.path); }
                                }
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: crumb.label;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    address-edit := LineEdit {
                        visible: root.address-editing;
                        text <=> root.address;
                        font-size: 12px;
                        accessible-label: "Adresse";
                        edited(t) => {
                            root.suggestion-index = -1;
                            root.address-edited(t);
                        }
                        accepted(t) => {
                            root.address-editing = false;
                            root.navigate-to(root.suggestion-index >= 0 && root.suggestion-index < root.suggestions.length
                                ? root.suggestions[root.suggestion-index] : t);
                            root.focus-list(root.active-pane);
                        }
                        key-pressed(e) => {
                            if e.text == Key.Escape {
                                root.address-editing = false;
                                root.focus-list(root.active-pane);
                                return accept;
                            }
                            if e.text == Key.DownArrow && root.suggestions.length > 0 {
                                root.suggestion-index = min(root.suggestions.length - 1, root.suggestion-index + 1);
                                return accept;
                            }
                            if e.text == Key.UpArrow && root.suggestions.length > 0 {
                                root.suggestion-index = max(-1, root.suggestion-index - 1);
                                return accept;
                            }
                            if e.text == Key.Tab && root.suggestions.length > 0 {
                                root.address = root.suggestions[max(0, root.suggestion-index)] + "\\";
                                root.suggestion-index = -1;
                                root.address-edited(root.address);
                                return accept;
                            }
                            reject
                        }
                        changed has-focus => {
                            if !self.has-focus {
                                root.address-editing = false;
                            }
                        }
                    }
                }
                filter-edit := LineEdit {
                    width: 220px;
                    placeholder-text: "Filtrer ce dossier";
                    text <=> root.filter-text;
                    font-size: 12px;
                    accessible-label: "Filtre";
                    edited(text) => { root.filter-edited(text); }
                    key-pressed(event) => {
                        if event.text == Key.Escape {
                            root.filter-text = "";
                            root.filter-edited("");
                            root.focus-list(root.active-pane);
                            return accept;
                        }
                        if event.text == Key.DownArrow {
                            root.focus-list(root.active-pane);
                            return reject;
                        }
                        reject
                    }
                }
                ToolButton {
                    glyph: (root.active-pane == 1 ? root.view-mode-1 : root.view-mode-0) == 1 ? "\u{E8FD}" : "\u{E8A9}";
                    tooltip: "Affichage : détails ou icônes (Ctrl+Maj+V)";
                    clicked => { root.toggle-view(); }
                }
                ToolButton {
                    glyph: "\u{E89F}";
                    tooltip: "Double volet (F6)";
                    clicked => { root.toggle-dual(); }
                }
                ToolButton {
                    glyph: "\u{E8A1}";
                    tooltip: "Volet d'aperçu (Alt+P)";
                    clicked => { root.toggle-preview(); }
                }
            }

            HorizontalLayout {
                spacing: 4px;
                NavPane {
                    items: root.nav-items;
                    activated(path) => { root.nav-activated(path); }
                }
                p0 := FolderPane {
                    horizontal-stretch: 1;
                    rows: root.rows-0;
                    active: root.active-pane == 0;
                    show-active: root.dual && root.active-pane == 0;
                    status: root.status-0;
                    error-text: root.error-text-0;
                    loading: root.loading-0;
                    filtering: root.filtering-0;
                    sort-column: root.sort-column-0;
                    sort-descending: root.sort-descending-0;
                    rename-row: root.rename-row-0;
                    rename-text: root.rename-text-0;
                    rename-stem: root.rename-stem-0;
                    drop-row: root.drop-row-0;
                    view-mode: root.view-mode-0;
                    grid-lines: root.grid-lines-0;
                    marquee-grid(la, lb, ca, cb) => { root.marquee-grid(0, la, lb, ca, cb); }
                    columns-changed(c) => { root.columns-changed(0, c); }
                    activated => { root.pane-activated(0); }
                    sort-by(c) => { root.sort-by(0, c); }
                    row-pointer(r, k, c, s, n) => { root.row-pointer(0, r, k, c, s, n); }
                    background-pointer(k, c, s) => { root.background-pointer(0, k, c, s); }
                    drag-out(r) => { root.drag-out(0, r); }
                    marquee-changed(a, b, c) => { root.marquee-changed(0, a, b, c); }
                    marquee-ended => { root.marquee-ended(0); }
                    rename-commit(t) => { root.rename-commit(0, t); }
                    rename-cancel => { root.rename-cancel(0); }
                    key(t, c, s, a) => { root.key(0, t, c, s, a) }
                }
                p1 := FolderPane {
                    horizontal-stretch: root.dual ? 1 : 0;
                    max-width: root.dual ? 100000px : 0px;
                    visible: root.dual;
                    rows: root.rows-1;
                    active: root.active-pane == 1;
                    show-active: root.dual && root.active-pane == 1;
                    status: root.status-1;
                    error-text: root.error-text-1;
                    loading: root.loading-1;
                    filtering: root.filtering-1;
                    sort-column: root.sort-column-1;
                    sort-descending: root.sort-descending-1;
                    rename-row: root.rename-row-1;
                    rename-text: root.rename-text-1;
                    rename-stem: root.rename-stem-1;
                    drop-row: root.drop-row-1;
                    view-mode: root.view-mode-1;
                    grid-lines: root.grid-lines-1;
                    marquee-grid(la, lb, ca, cb) => { root.marquee-grid(1, la, lb, ca, cb); }
                    columns-changed(c) => { root.columns-changed(1, c); }
                    activated => { root.pane-activated(1); }
                    sort-by(c) => { root.sort-by(1, c); }
                    row-pointer(r, k, c, s, n) => { root.row-pointer(1, r, k, c, s, n); }
                    background-pointer(k, c, s) => { root.background-pointer(1, k, c, s); }
                    drag-out(r) => { root.drag-out(1, r); }
                    marquee-changed(a, b, c) => { root.marquee-changed(1, a, b, c); }
                    marquee-ended => { root.marquee-ended(1); }
                    rename-commit(t) => { root.rename-commit(1, t); }
                    rename-cancel => { root.rename-cancel(1); }
                    key(t, c, s, a) => { root.key(1, t, c, s, a) }
                }
                // --- Volet d'aperçu ---
                Rectangle {
                    width: root.preview-visible ? 340px : 0px;
                    visible: root.preview-visible;
                    background: Theme.layer;
                    border-top-left-radius: 8px;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Text {
                            text: root.preview-title;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        preview-area := Rectangle {
                            vertical-stretch: 1;
                            clip: true;
                            if root.preview-kind == 0: Text {
                                width: parent.width;
                                text: root.preview-text;
                                font-size: 12px;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                            if root.preview-kind == 1: Text {
                                width: parent.width;
                                height: parent.height;
                                text: root.preview-text;
                                font-family: "Cascadia Mono";
                                font-size: 11px;
                                wrap: word-wrap;
                                vertical-alignment: top;
                            }
                            if root.preview-kind == 2: Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.preview-image;
                                image-fit: contain;
                            }
                        }
                    }
                }
            }
        }
    }

    // Suggestions d'autocomplétion de l'adresse, au-dessus du contenu.
    if root.address-editing && root.suggestions.length > 0: Rectangle {
        x: address-box.absolute-position.x - root.absolute-position.x;
        y: address-box.absolute-position.y - root.absolute-position.y + address-box.height + 2px;
        width: address-box.width;
        height: min(root.suggestions.length, 10) * 28px + 8px;
        background: Theme.popup;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.divider;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000040;
        VerticalLayout {
            padding: 4px;
            for s[i] in root.suggestions: Rectangle {
                height: 28px;
                border-radius: 4px;
                background: i == root.suggestion-index ? Theme.selected : sta.has-hover ? Theme.hover : transparent;
                sta := TouchArea {
                    clicked => {
                        root.address-editing = false;
                        root.navigate-to(s);
                        root.focus-list(root.active-pane);
                    }
                }
                Text {
                    x: 10px;
                    text: s;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    // Palette de commandes (Ctrl+Maj+P).
    if root.palette-open: Rectangle {
        background: #00000030;
        TouchArea {
            clicked => {
                root.palette-open = false;
                root.focus-list(root.active-pane);
            }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 80px;
            width: min(560px, parent.width - 40px);
            height: 52px + min(root.palette-items.length, 12) * 32px;
            background: Theme.popup;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.divider;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                LineEdit {
                    placeholder-text: "Rechercher une commande";
                    init => { self.focus(); }
                    text <=> root.palette-query;
                    font-size: 13px;
                    edited(t) => {
                        root.palette-index = 0;
                        root.palette-edited(t);
                    }
                    accepted => {
                        root.palette-open = false;
                        root.palette-run(root.palette-index);
                    }
                    key-pressed(e) => {
                        if e.text == Key.Escape {
                            root.palette-open = false;
                            root.focus-list(root.active-pane);
                            return accept;
                        }
                        if e.text == Key.DownArrow {
                            root.palette-index = min(root.palette-items.length - 1, root.palette-index + 1);
                            return accept;
                        }
                        if e.text == Key.UpArrow {
                            root.palette-index = max(0, root.palette-index - 1);
                            return accept;
                        }
                        reject
                    }
                }
                for item[i] in root.palette-items: Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: i == root.palette-index ? Theme.selected : pta.has-hover ? Theme.hover : transparent;
                    pta := TouchArea {
                        clicked => {
                            root.palette-open = false;
                            root.palette-run(i);
                        }
                    }
                    Text {
                        x: 10px;
                        text: item.label;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        x: parent.width - self.width - 10px;
                        text: item.hint;
                        font-size: 11px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
